# ====================================================================
#  Reglages du conteneur — copier en .env a cote du docker-compose
# ====================================================================
#  Ne contient AUCUN secret : l'application n'a ni compte, ni cle d'API.
#  Les reglages metier (communes, secteurs, filtres) se modifient dans
#  l'ecran Reglages et vivent en base, pas ici.
# ====================================================================

# Port par lequel le NAS expose l'application.
# 8000 est deja pris par gestion-locative : on decale.
VEILLE_PORT_HOTE=8020

# Fuseau horaire. Indispensable, sinon l'import hebdomadaire part en UTC.
TZ=Europe/Paris

# Jour et heure de l'import automatique (mon, tue, wed, thu, fri, sat, sun).
VEILLE_IMPORT_JOUR=mon
VEILLE_IMPORT_HEURE=7

# Mettre a 0 pour desactiver completement l'import automatique.
VEILLE_PLANIFICATEUR=1

# Niveau de journalisation : DEBUG, INFO, WARNING, ERROR.
VEILLE_LOG=INFO
