# ====================================================================
#  Reglages du conteneur — copier en .env a cote du docker-compose
# ====================================================================
#  Les identifiants SMTP ci-dessous sont les SEULS secrets du fichier.
#  Ne jamais le committer : .gitignore couvre .env, le depot est public.
#  Les reglages metier (communes, secteurs, filtres, alerte) se modifient
#  dans l'ecran Reglages et vivent en base, pas ici.
# ====================================================================

# Port par lequel le NAS expose l'application.
# 8000 est deja pris par gestion-locative : on decale.
VEILLE_PORT_HOTE=8020

# Fuseau horaire. Indispensable, sinon l'import hebdomadaire part en UTC.
TZ=Europe/Paris

# Jour et heure de l'import automatique. « * » = tous les jours ; sinon
# mon, tue, wed, thu, fri, sat, sun. L'alerte courriel suit l'import.
VEILLE_IMPORT_JOUR=*
VEILLE_IMPORT_HEURE=7

# Mettre a 0 pour desactiver completement l'import automatique.
VEILLE_PLANIFICATEUR=1

# Niveau de journalisation : DEBUG, INFO, WARNING, ERROR.
VEILLE_LOG=INFO

# ====================================================================
#  Alerte par courriel (F6)
# ====================================================================
#  Laisser VEILLE_SMTP_HOTE vide desactive tout envoi : l'application
#  reste utilisable, et l'ecran Reglages le dit au lieu d'echouer.
#
#  L'activation, le destinataire et le secteur surveille se reglent dans
#  l'ecran Reglages, pas ici : eux ne sont pas des secrets.

# Serveur d'envoi. Exemple pour Gmail : smtp.gmail.com
VEILLE_SMTP_HOTE=
# 587 pour STARTTLS (defaut), 465 pour SSL direct.
VEILLE_SMTP_PORT=587
# Mettre a 1 avec le port 465.
VEILLE_SMTP_SSL=0

# Adresse d'expedition. Obligatoire des que l'hote est renseigne.
VEILLE_SMTP_EXPEDITEUR=

# Identifiants. Laisser vides si le relais n'en demande pas.
#
# ATTENTION : avec un mot de passe renseigne, l'application REFUSE
# d'envoyer si le serveur n'annonce pas STARTTLS — il partirait en clair.
# Passer alors au port 465 avec VEILLE_SMTP_SSL=1.
#
# Pour Gmail, un mot de passe d'application est indispensable : le mot de
# passe du compte est refuse depuis la fin de l'acces « applications moins
# securisees ».
VEILLE_SMTP_UTILISATEUR=
VEILLE_SMTP_MOTDEPASSE=
