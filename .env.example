# ====================================================================
#  Reglages du conteneur — copier en .env a cote du docker-compose
# ====================================================================
#  Ne contient AUCUN secret dans son usage normal : le serveur d'envoi se
#  regle dans l'ecran Reglages, comme le reste. Les variables SMTP en fin
#  de fichier ne sont qu'un repli, et peuvent rester vides.
#  Ne jamais committer ce fichier : .gitignore couvre .env, le depot est
#  public.
# ====================================================================

# Port par lequel le NAS expose l'application.
# 8000 est deja pris par gestion-locative : on decale.
VEILLE_PORT_HOTE=8020

# Fuseau horaire. Indispensable, sinon l'import hebdomadaire part en UTC.
TZ=Europe/Paris

# Jour et heure de l'import automatique. « * » = tous les jours ; sinon
# mon, tue, wed, thu, fri, sat, sun. L'alerte courriel suit l'import.
VEILLE_IMPORT_JOUR=*
VEILLE_IMPORT_HEURE=7

# Mettre a 0 pour desactiver completement l'import automatique.
VEILLE_PLANIFICATEUR=1

# Niveau de journalisation : DEBUG, INFO, WARNING, ERROR.
VEILLE_LOG=INFO

# ====================================================================
#  Alerte par courriel (F6) — FACULTATIF
# ====================================================================
#  Le serveur d'envoi se regle dans l'ecran Reglages : rien n'est
#  necessaire ici. Ces variables ne servent plus que de repli, pour une
#  installation qui les avait deja posees. Des que le serveur est
#  renseigne dans l'ecran, il prime, et l'ecran dit laquelle des deux
#  sources est en vigueur.
#
#  Les laisser vides est le cas normal.

VEILLE_SMTP_HOTE=
VEILLE_SMTP_PORT=587
VEILLE_SMTP_SSL=0
VEILLE_SMTP_EXPEDITEUR=
VEILLE_SMTP_UTILISATEUR=
VEILLE_SMTP_MOTDEPASSE=
